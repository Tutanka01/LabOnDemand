# Configuration de l'API
API_PORT=8000
DEBUG_MODE=True
FRONTEND_PORT=80
CORS_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:8000

# ===================== Logs =====================
# Niveau de log minimal (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO

# Rotation des logs applicatifs (app.log, access.log)
# LOG_MAX_BYTES=5242880      # 5 MiB par fichier
# LOG_BACKUP_COUNT=10        # 10 archives → ~55 MiB max par fichier

# Rotation spécifique à audit.log (rétention plus longue recommandée en production)
# AUDIT_LOG_MAX_BYTES=10485760   # 10 MiB par fichier (défaut)
# AUDIT_LOG_BACKUP_COUNT=30      # 30 archives → ~310 MiB d'historique audit max

# Configuration de la base de données
DB_ROOT_PASSWORD=root_password_secret
DB_USER=labondemand
DB_PASSWORD=secure_password_secret
DB_NAME=labondemand
DB_PORT=3306
DB_HOST=db

# Vous pouvez ajouter d'autres variables d'environnement selon vos besoins
# Par exemple:
# SECRET_KEY=your-api-secret-key-here

# Domaine de base pour les URL des labs
BASE_DOMAIN=labondemand.local
SECRET_KEY="une_super_cle_secrete_tres_longue_et_aleatoire_a_changer_absolument"
ACCESS_TOKEN_EXPIRE_MINUTES=60 # Durée de validité du token

# ===================== Sessions & Redis =====================
REDIS_PASSWORD=change-me
# URL de connexion Redis pour le stockage des sessions (dev: service docker-compose)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# Namespace de clés Redis (optionnel)
REDIS_NAMESPACE=session:
# Durée de vie des sessions (heures)
SESSION_EXPIRY_HOURS=24
# Cookies de session: en dev, laissez False pour autoriser HTTP; en prod mettez True (HTTPS requis)
SECURE_COOKIES=False
# Politique SameSite du cookie de session: Lax ou Strict
SESSION_SAMESITE=Lax
# Domaine du cookie (laisser vide pour localhost en dev; ex prod: .example.com)
COOKIE_DOMAIN=

# ===================== Kubernetes (optionnel) =====================
# IP externe du cluster si applicable (sinon laisser vide)
CLUSTER_EXTERNAL_IP=
# Taille du volume persistant créé pour les labs qui conservent les données
# (VS Code, Jupyter, bureau VNC). Les PVC existants ne sont pas redimensionnés.
# LAB_PVC_SIZE=5Gi

# ===================== Concurrence & client Kubernetes =====================
# Délais par défaut (secondes) des appels REST Kubernetes : connexion puis
# lecture. 0 désactive. Les flux (watch, logs suivis) n'ont pas de délai de
# lecture ; un délai explicite dans le code reste prioritaire.
# K8S_REQUEST_TIMEOUT_CONNECT=5
# K8S_REQUEST_TIMEOUT_READ=30
# Taille du pool de threads de l'API (endpoints synchrones, appels déportés).
# À garder <= pool_size + max_overflow de SQLAlchemy (10 + 30 = 40).
# API_THREADPOOL_SIZE=40
# Déploiements simultanés lors d'un déploiement en masse (devoir → classe).
# BULK_SPAWN_CONCURRENCY=5
# Grading Runs simultanés lors d'un lancement des tests sur toute la classe.
# BULK_GRADING_CONCURRENCY=5
# TTL (s) du verrou Redis qui élit le processus exécutant le nettoyage périodique.
# Doit dépasser une itération (intervalle + cycle). 0/vide = 2 x CLEANUP_INTERVAL_MINUTES.
# CLEANUP_LOCK_TTL_SECONDS=0
# Ferme (code 4408) un terminal web sans aucun échange (saisie ou sortie) pendant
# ce délai en secondes, ce qui libère le flux exec et son thread. 0 = jamais.
# TERMINAL_IDLE_TIMEOUT_SECONDS=1800
# Délai (secondes, entier) de chaque sonde de GET /api/v1/health (DB, Redis,
# Kubernetes, en parallèle) ; au-delà, la dépendance est signalée « degraded ».
# HEALTH_CHECK_TIMEOUT_SECONDS=3

# ===================== Grader Pod (tests automatiques) =====================
# Image du grader (à publier sur le registre du cluster — voir dockerfiles/grader/).
GRADER_IMAGE=tutanka01/labondemand:grader
# Namespace dédié et verrouillé où tournent les Jobs grader éphémères.
GRADER_NAMESPACE=labondemand-grader
# Auto-suppression du Job (ttlSecondsAfterFinished).
# GRADER_JOB_TTL_SECONDS=180
# Intervalle de polling du statut du Job par l'API.
# GRADER_POLL_INTERVAL_SECONDS=3
# Marge ajoutée au timeout de la spec avant de déclarer un run en erreur.
# GRADER_WATCH_GRACE_SECONDS=30
# Délai au-delà duquel un run bloqué (queued/running) est réconcilié en erreur (cleanup).
# GRADING_RUN_STUCK_MINUTES=15

# ===================== Admin (sécurité) =====================
# Définissez le mot de passe initial de l'admin via env (recommandé). En prod, utilisez un Secret Kubernetes.
# Si non défini, un mot de passe aléatoire sera généré au démarrage.
ADMIN_DEFAULT_PASSWORD=changez-moi-en-dev

# ===================== SSO (optionnel) =====================
SSO_ENABLED=True
OIDC_ISSUER=https://sso.univ-pau.fr/cas/oidc
OIDC_CLIENT_ID=votre_client_id          
OIDC_CLIENT_SECRET=votre_client_secret  
OIDC_REDIRECT_URI=https://votre-app.fr/api/v1/auth/sso/callback

# ===================== Ingress (Kubernetes) =====================
# Expose les labs sur des URLs en ports standard (80/443) au lieu des NodePorts
# 30000-32767, souvent filtrés par le réseau de l'université.
# Prérequis : déployer le contrôleur Ingress Traefik :
#   kubectl apply -f deploy/ingress/traefik-ingress.yaml
# Voir documentation/ingress-labs.md
INGRESS_ENABLED=true
# Domaine de base : les URLs ont la forme <app>-<id>-u<user>.<INGRESS_BASE_DOMAIN>
#   - sslip.io : zéro configuration DNS (l'IP du nœud est encodée dans le nom)
#     ex: 10.3.17.139.sslip.io  ->  vscode-5172-u1.10.3.17.139.sslip.io
#   - ou un wildcard DNS interne : ex. apps.labondemand.univ-pau.fr
INGRESS_BASE_DOMAIN=10.3.17.139.sslip.io
# Doit correspondre à l'IngressClass créée par le manifeste Traefik
INGRESS_CLASS_NAME=traefik
INGRESS_TLS_SECRET=   # secret TLS (laisser vide pour HTTP)
INGRESS_DEFAULT_PATH=/
INGRESS_PATH_TYPE=Prefix
INGRESS_FORCE_TLS_REDIRECT=false
# Types exposés via Ingress — netbeans = bureau distant noVNC (port 6901, HTTP+WebSocket)
INGRESS_AUTO_TYPES=custom,jupyter,vscode,wordpress,mysql,lamp,netbeans
# Types laissés en NodePort volontairement (vide = tout passe par l'Ingress)
INGRESS_EXCLUDED_TYPES=
